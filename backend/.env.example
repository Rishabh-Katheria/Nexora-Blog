# Copy to .env and fill in real values. Never commit .env.

# Required — JWT signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Database (PostgreSQL)
DATABASE_URL=

# JWT lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Canonical public URL of the deployed site (no trailing slash).
# Used for absolute Open Graph / Twitter / canonical / structured-data URLs.
# Leave unset to derive it from the request origin.
# Example: SITE_URL=https://www.nexora.com
SITE_URL=

# CORS — extra deployed frontend origin (local origins are built in)
FRONTEND_URL=

# Cloudinary (only needed for legacy images / direct uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production: set DEBUG=False (hides /docs and /redoc)
DEBUG=True

# Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Rate limiting for auth endpoints (login/register)
# Max attempts per window; set to 0 to disable.
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Object storage (future S3 migration — optional, not required)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
