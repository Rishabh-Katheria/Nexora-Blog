# Base URL of the FastAPI backend (no trailing slash). Public config — not a secret.
# In production, set this to your deployed backend origin (e.g. https://api.nexora.com).
# Do NOT use localhost URLs in production.
VITE_API_URL=http://127.0.0.1:8000

# Canonical public URL of the deployed site (no trailing slash).
# Used for canonical links, Open Graph / Twitter URLs and the sitemap.
# Leave unset during local development to fall back to the current origin.
# Example: VITE_SITE_URL=https://www.nexora.com
VITE_SITE_URL=
